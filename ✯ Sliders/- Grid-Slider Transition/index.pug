.preloader
  .preloader-counter 0

.container
  .grid-container
    #grid.grid
      .grid-item(data-index="0")
        .grid-item-img(style="background-image:url(https://cdn.cosmos.so/dfff1381-f09c-454b-b98d-8a79161c3d25?format=jpeg)")
      .grid-item(data-index="1")
        .grid-item-img(style="background-image:url(https://cdn.cosmos.so/c7af8b26-313a-40e4-9081-85f7fde00c22?format=jpeg)")
      .grid-item(data-index="2")
        .grid-item-img(style="background-image:url(https://cdn.cosmos.so/03a36d87-af8c-4cfe-bfed-7a3dd502404b.?format=jpeg)")
      .grid-item(data-index="3")
        .grid-item-img(style="background-image:url(https://cdn.cosmos.so/bdb2a659-2838-4055-a82e-f145c3fd4467?format=jpeg)")
      .grid-item.target#target-item(data-index="4")
        .grid-item-img(style="background-image:url(https://cdn.cosmos.so/fddfc757-d9c3-44f1-af6e-a607c3746738?format=jpeg)")
      .grid-item(data-index="5")
